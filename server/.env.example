# Run python -m flightdeck configure to create this file and the encryption key.
FLIGHTDECK_MODE=live
FLIGHTDECK_DATABASE=data/live-accounts.sqlite3
# Keep this separate from database backups and never commit or expose it.
FLIGHTDECK_ENCRYPTION_KEY_FILE=secrets/master.key
FLIGHTDECK_REGISTRATION_OPEN=true
FLIGHTDECK_SESSION_DAYS=90
# Per-user safety ceiling. May only lower the $4.50 operational ceiling.
FLIGHTDECK_BUDGET_USD=4.50
# Live mode fails closed after this review deadline. Review prices before extending.
FLIGHTDECK_PRICING_VALID_UNTIL=2026-11-18
# No shared token or provider key: users authenticate and add keys through the app.
