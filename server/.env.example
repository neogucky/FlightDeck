# Copy to .env, or run: python -m flightdeck configure
FLIGHTDECK_MODE=demo
FLIGHTDECK_ACCESS_TOKEN=replace-with-a-random-token-of-at-least-32-characters
FLIGHTDECK_DATABASE=data/flightdeck.sqlite3
FLIGHTAWARE_API_KEY=
# Live mode fails closed after this review deadline. Review current prices before extending.
FLIGHTDECK_PRICING_VALID_UNTIL=2026-11-18
# May only lower the $4.50 operational ceiling. $0.50 is always held back from $5.
FLIGHTDECK_BUDGET_USD=4.50
